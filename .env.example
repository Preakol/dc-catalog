# Copy to .env:  cp .env.example .env
# These values are compiled into the browser bundle and are visible to any user.
# Never put secrets here — addresses only.

API_URL=http://localhost:3000
HEROES_API_URL=https://akabab.github.io/superhero-api/api

# Stripe TEST publishable key (pk_test_...). Safe to expose: it can only
# tokenise cards, never move money. Get one at:
#   https://dashboard.stripe.com/test/apikeys
# Leave empty to keep checkout disabled.
STRIPE_PUBLISHABLE_KEY=
